{
  "name": "acervo-boardgames",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Biblioteca pessoal de manuais de jogos de tabuleiro, em JavaScript puro.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:rules": "firebase emulators:exec --project demo-acervo --only auth,firestore \"node --test security/*.test.mjs\"",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.33.0",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=24.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "basic-ftp": "6.2.3",
    "@opentelemetry/core": "2.12.0",
    "gaxios": {
      "uuid": "11.1.1"
    },
    "firebase-tools": {
      "chokidar": "4.0.3"
    }
  }
}
