{
  "name": "acervo-boardgames",
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "description": "Biblioteca pessoal de manuais de jogos de tabuleiro, em JavaScript puro.",
  "scripts": {
    "start": "node scripts/serve.mjs --real",
    "build": "node scripts/build.mjs",
    "test": "node --import ./scripts/test-guard.mjs --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:rules": "node scripts/test-guard.mjs && firebase emulators:exec --project demo-acervo --only auth,firestore \"node --import ./scripts/test-guard.mjs --test security/*.test.mjs\"",
    "format": "prettier --write .",
    "dev": "node scripts/dev.mjs",
    "dev:open": "node scripts/dev.mjs open",
    "dev:reset": "node scripts/dev.mjs reset",
    "dev:stop": "node scripts/dev.mjs stop",
    "serve": "node scripts/serve.mjs",
    "test:dev": "node scripts/dev-test.mjs",
    "test:install": "npm ci --prefix tests/runtime --ignore-scripts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.33.0",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=24.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "basic-ftp": "6.2.3",
    "@opentelemetry/core": "2.12.0",
    "gaxios": {
      "uuid": "11.1.1"
    },
    "firebase-tools": {
      "chokidar": "4.0.3"
    }
  }
}
