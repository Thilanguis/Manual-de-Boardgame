rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function active() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function owner() {
      return active() && request.auth.uid == '7TitBObtb8a0W8GisSstSM1RHiX2'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
    function subadmin() { return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin'; }
    function allowed(permission) { return owner() || (subadmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[permission] == true); }
    function admin() { return owner() || subadmin(); }
    function reviewer() { return allowed('approveUsers'); }
    function publicLibrary() {
      return !exists(/databases/$(database)/documents/settings/library) || get(/databases/$(database)/documents/settings/library).data.publicRead == true;
    }
    function validPermissions(p, role) {
      return p is map && p.keys().hasOnly(['approveUsers','addGames','editGames','deleteGames'])
        && p.keys().hasAll(['approveUsers','addGames','editGames','deleteGames'])
        && p.approveUsers is bool && p.addGames is bool && p.editGames is bool && p.deleteGames is bool
        && (role == 'superadmin' || p.deleteGames == false)
        && (role != 'user' || (p.approveUsers == false && p.addGames == false && p.editGames == false && p.deleteGames == false));
    }
    function validUser(u, uid) {
      return u.keys().hasOnly(['uid','name','email','role','status','permissions','createdAt','updatedAt','version','lastEventId'])
        && u.keys().hasAll(['uid','name','email','role','status','permissions','createdAt','updatedAt','version','lastEventId'])
        && u.uid == uid && u.name is string && u.name.size() > 0 && u.name.size() <= 100
        && u.email is string && u.email.size() > 0 && u.email.size() <= 320
        && u.role in ['user','subadmin','superadmin'] && u.status in ['pending','approved','rejected','blocked']
        && (u.role != 'superadmin' || uid == '7TitBObtb8a0W8GisSstSM1RHiX2')
        && (uid != '7TitBObtb8a0W8GisSstSM1RHiX2' || u.role == 'superadmin')
        && validPermissions(u.permissions,u.role) && u.createdAt is timestamp && u.updatedAt == request.time
        && u.version is int && u.version >= 1 && u.lastEventId is string && u.lastEventId.size() <= 100;
    }
    function summary(u) { return {'role':u.role,'status':u.status,'permissions':u.permissions}; }
    function userTransition(before, after, action) {
      let root = owner();
      let review = root || reviewer();
      return (action == 'approve' && review && before.role == 'user' && before.status == 'pending' && after.role == 'user' && after.status == 'approved' && after.permissions == before.permissions)
        || (action == 'reject' && review && before.role == 'user' && before.status == 'pending' && after.role == 'user' && after.status == 'rejected' && after.permissions == before.permissions)
        || (root && (
          (action == 'promote' && before.role == 'user' && before.status == 'approved' && after.role == 'subadmin' && after.status == 'approved')
          || (action == 'demote' && before.role == 'subadmin' && after.role == 'user' && after.status == before.status)
          || (action == 'permissions' && before.role == 'subadmin' && after.role == 'subadmin' && after.status == before.status)
          || (action == 'block' && before.status != 'blocked' && after.status == 'blocked' && after.role == before.role && after.permissions == before.permissions)
          || (action == 'unblock' && before.status == 'blocked' && after.status == 'approved' && after.role == before.role && after.permissions == before.permissions)));
    }
    function validUserEvent(e, id) {
      let before = get(/databases/$(database)/documents/users/$(e.targetId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(e.targetId)).data;
      return e.targetId != request.auth.uid && e.targetId != '7TitBObtb8a0W8GisSstSM1RHiX2'
        && after.lastEventId == id && after.version == before.version + 1 && e.version == after.version
        && after.updatedAt == request.time && e.before == summary(before) && e.after == summary(after)
        && userTransition(before,after,e.action);
    }
    function validSettingsEvent(e, id) {
      let before = get(/databases/$(database)/documents/settings/library).data;
      let after = getAfter(/databases/$(database)/documents/settings/library).data;
      return owner() && e.targetId == 'library' && e.action == 'librarySettings' && after.lastEventId == id
        && after.version == before.version + 1 && e.version == after.version && after.updatedAt == request.time
        && e.before == {'publicRead':before.publicRead} && e.after == {'publicRead':after.publicRead};
    }
    function validEvent(e, id) {
      return signedIn() && e.keys().hasOnly(['id','targetType','targetId','actorUid','action','before','after','version','createdAt'])
        && e.keys().hasAll(['id','targetType','targetId','actorUid','action','before','after','version','createdAt'])
        && e.id == id && e.actorUid == request.auth.uid && e.createdAt == request.time
        && ((e.targetType == 'user' && validUserEvent(e,id)) || (e.targetType == 'settings' && validSettingsEvent(e,id)));
    }
    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || reviewer();
      allow list: if reviewer();
      // O perfil inicial só pode ser pending/user. O proprietário é criado pelo procedimento IAM local.
      allow create: if signedIn() && request.auth.uid == uid && uid != '7TitBObtb8a0W8GisSstSM1RHiX2'
        && validUser(request.resource.data,uid) && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user' && request.resource.data.status == 'pending'
        && request.resource.data.version == 1 && request.resource.data.lastEventId == '' && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid != uid && uid != '7TitBObtb8a0W8GisSstSM1RHiX2'
        && validUser(request.resource.data,uid) && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.version == resource.data.version + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status','permissions','version','updatedAt','lastEventId'])
        && validEvent(getAfter(/databases/$(database)/documents/auditEvents/$(request.resource.data.lastEventId)).data,request.resource.data.lastEventId);
      allow delete: if false;
    }
    match /auditEvents/{id} {
      allow read: if reviewer();
      allow create: if validEvent(request.resource.data,id);
      allow update, delete: if false;
    }
    match /admins/{uid} { allow read, write: if false; }
    match /settings/library {
      allow get: if true;
      allow list, create, delete: if false;
      allow update: if owner() && request.resource.data.keys().hasOnly(['publicRead','version','updatedAt','lastEventId'])
        && request.resource.data.keys().hasAll(['publicRead','version','updatedAt','lastEventId'])
        && request.resource.data.publicRead is bool && request.resource.data.updatedAt == request.time
        && request.resource.data.version == resource.data.version + 1
        && validEvent(getAfter(/databases/$(database)/documents/auditEvents/$(request.resource.data.lastEventId)).data,request.resource.data.lastEventId);
    }
    function optionalNumber(value, max) { return value == null || (value is int && value >= 1 && value <= max); }
    function validGame(id) {
      let g = request.resource.data;
      return g.keys().hasOnly(['id','title','description','minPlayers','maxPlayers','durationMinutes','tags','language','manual','cover','sources','bgg','createdAt','updatedAt','createdBy','schemaVersion','isPublic','deleting','deleteRequestedBy'])
        && g.keys().hasAll(['id','title','description','minPlayers','maxPlayers','durationMinutes','tags','language','manual','cover','sources','createdAt','updatedAt','createdBy','schemaVersion','isPublic','deleting'])
        && g.id == id && g.schemaVersion == 1 && g.isPublic is bool && g.deleting is bool
        && g.title is string && g.title.size() > 0 && g.title.size() <= 160
        && g.description is string && g.description.size() <= 2000
        && optionalNumber(g.minPlayers,100) && optionalNumber(g.maxPlayers,100)
        && ((g.minPlayers == null && g.maxPlayers == null) || (g.minPlayers != null && g.maxPlayers != null && g.minPlayers <= g.maxPlayers))
        && optionalNumber(g.durationMinutes,1440)
        && g.tags is list && g.tags.size() <= 8 && g.language is string && g.language.size() <= 20
        && g.manual is map && g.manual.path == 'games/' + id + '/manual.pdf'
        && g.manual.name is string && g.manual.name.size() <= 255
        && g.manual.type == 'application/pdf' && g.manual.size is int && g.manual.size > 0 && g.manual.size <= 52428800
        && g.manual.pages is int && g.manual.pages >= 1
        && g.manual.sha256 is string && g.manual.sha256.matches('^[a-f0-9]{64}$')
        && g.manual.storage == 'drive' && g.manual.driveFileId is string && g.manual.driveFileId.matches('^[A-Za-z0-9_-]{6,200}$')
        && g.cover is map && g.sources is map && g.createdAt is timestamp && g.updatedAt == request.time && g.createdBy is string;
    }
    match /games/{id} {
      allow read: if admin() || ((!('deleting' in resource.data) || resource.data.deleting == false) && (publicLibrary() || resource.data.isPublic == true));
      allow create: if allowed('addGames') && validGame(id) && request.resource.data.deleting == false && !('deleteRequestedBy' in request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if validGame(id) && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && ((allowed('editGames') && (!('deleting' in resource.data) || resource.data.deleting == false)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleting','deleteRequestedBy']))
        || (owner() && request.resource.data.deleting == true && request.resource.data.deleteRequestedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting','deleteRequestedBy','updatedAt'])));
      allow delete: if owner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
