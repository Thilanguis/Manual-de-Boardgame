rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().uid == request.auth.uid && profile().status == 'approved' && (profile().role in ['user','subadmin'] || (request.auth.uid == '7TitBObtb8a0W8GisSstSM1RHiX2' && profile().role == 'superadmin')); }
    function owner() { return signedIn() && request.auth.uid == '7TitBObtb8a0W8GisSstSM1RHiX2' && profile().uid == request.auth.uid && profile().status == 'approved' && profile().role == 'superadmin'; }
    function subadmin() { return active() && profile().role == 'subadmin'; }
    function allowed(permission) { return signedIn() && (owner() || (subadmin() && profile().permissions[permission] == true)); }
    function admin() { return owner() || subadmin(); }
    function reviewer() { return owner() || (subadmin() && profile().permissions.approveUsers == true); }
    function publicLibrary() {
      return !exists(/databases/$(database)/documents/settings/library) || get(/databases/$(database)/documents/settings/library).data.publicRead == true;
    }
    function validPermissions(p, role) {
      return p is map && p.keys().hasOnly(['approveUsers','addGames','editGames','deleteGames'])
        && p.keys().hasAll(['approveUsers','addGames','editGames','deleteGames'])
        && p.approveUsers is bool && p.addGames is bool && p.editGames is bool && p.deleteGames is bool
        && (role == 'superadmin' || p.deleteGames == false)
        && (role != 'user' || (p.approveUsers == false && p.addGames == false && p.editGames == false && p.deleteGames == false));
    }
    function validUser(u, uid) {
      return u.keys().hasOnly(['uid','name','email','role','status','permissions','createdAt','updatedAt','version','lastEventId','blockedFrom'])
        && u.keys().hasAll(['uid','name','email','role','status','permissions','createdAt','updatedAt','version','lastEventId'])
        && u.uid == uid && u.name is string && u.name.size() > 0 && u.name.size() <= 100
        && u.email is string && u.email.size() > 0 && u.email.size() <= 320
        && u.role in ['user','subadmin','superadmin'] && u.status in ['pending','approved','rejected','blocked']
        && (u.role != 'superadmin' || uid == '7TitBObtb8a0W8GisSstSM1RHiX2')
        && (uid != '7TitBObtb8a0W8GisSstSM1RHiX2' || u.role == 'superadmin')
        && validPermissions(u.permissions,u.role) && u.createdAt is timestamp && u.updatedAt == request.time
        && u.get('blockedFrom','') in ['', 'approved', 'pending', 'rejected']
        && (u.status == 'blocked' || u.get('blockedFrom','') == '')
        && u.version is int && u.version >= 1 && u.lastEventId is string && u.lastEventId.size() <= 100;
    }
    function summary(u) {
      return u.keys().hasAny(['blockedFrom'])
        ? {'role':u.role,'status':u.status,'permissions':u.permissions,'blockedFrom':u.blockedFrom}
        : {'role':u.role,'status':u.status,'permissions':u.permissions};
    }
    function retainedPermissions(u) {
      return {'approveUsers':u.role == 'subadmin' && u.permissions.get('approveUsers',false) == true,'addGames':u.role == 'subadmin' && u.permissions.get('addGames',false) == true,'editGames':u.role == 'subadmin' && u.permissions.get('editGames',false) == true,'deleteGames':false};
    }
    function unblockedStatus(u) {
      let path = /databases/$(database)/documents/auditEvents/$(u.lastEventId == '' ? '__missing_block__' : u.lastEventId);
      return u.get('blockedFrom','') != '' ? u.blockedFrom
        : u.lastEventId != '' && exists(path)
          && get(path).data.action == 'block' && get(path).data.targetType == 'user'
          && get(path).data.targetId == u.uid && get(path).data.version == u.version
          && get(path).data.after.status == 'blocked' && get(path).data.after.role == u.role
          && get(path).data.before.status in ['approved','pending','rejected']
          ? get(path).data.before.status : 'pending';
    }
    function userTransition(before, after, action) {
      let root = owner();
      let review = root || reviewer();
      return (action == 'approve' && review && before.role == 'user' && before.status == 'pending' && after.role == 'user' && after.status == 'approved' && after.permissions == retainedPermissions(before))
        || (action == 'reject' && review && before.role == 'user' && before.status == 'pending' && after.role == 'user' && after.status == 'rejected' && after.permissions == retainedPermissions(before))
        || (root && (
          (action == 'promote' && before.role == 'user' && before.status == 'approved' && after.role == 'subadmin' && after.status == 'approved')
          || (action == 'demote' && before.role == 'subadmin' && after.role == 'user' && after.status == before.status)
          || (action == 'permissions' && before.role == 'subadmin' && after.role == 'subadmin' && after.status == before.status)
          || (action == 'block' && before.status != 'blocked' && after.status == 'blocked' && after.get('blockedFrom','') == before.status && after.role == before.role && after.permissions == retainedPermissions(before))
          || (action == 'unblock' && before.status == 'blocked' && after.status == unblockedStatus(before) && after.get('blockedFrom','') == '' && after.role == before.role && after.permissions == retainedPermissions(before))));
    }
    function validUserEvent(e, id) {
      let before = get(/databases/$(database)/documents/users/$(e.targetId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(e.targetId)).data;
      return e.targetId != request.auth.uid && e.targetId != '7TitBObtb8a0W8GisSstSM1RHiX2'
        && after.lastEventId == id && after.version == before.version + 1 && e.version == after.version
        && after.updatedAt == request.time && e.before == summary(before) && e.after == summary(after)
        && (e.action in ['block','unblock'] || after.get('blockedFrom','') == before.get('blockedFrom','')
          || (before.status == 'blocked' && before.get('blockedFrom','') == '' && after.get('blockedFrom','') == unblockedStatus(before)))
        && userTransition(before,after,e.action);
    }
    function validSettingsEvent(e, id) {
      let before = get(/databases/$(database)/documents/settings/library).data;
      let after = getAfter(/databases/$(database)/documents/settings/library).data;
      return owner() && e.targetId == 'library' && e.action == 'librarySettings' && after.lastEventId == id
        && after.version == before.version + 1 && e.version == after.version && after.updatedAt == request.time
        && e.before == {'publicRead':before.publicRead} && e.after == {'publicRead':after.publicRead};
    }
    function validEvent(e, id) {
      return signedIn() && e.keys().hasOnly(['id','targetType','targetId','actorUid','action','before','after','version','createdAt'])
        && e.keys().hasAll(['id','targetType','targetId','actorUid','action','before','after','version','createdAt'])
        && e.id == id && e.actorUid == request.auth.uid && e.createdAt == request.time
        && ((e.targetType == 'user' && validUserEvent(e,id)) || (e.targetType == 'settings' && validSettingsEvent(e,id)) || (e.targetType == 'guide' && validGuideEvent(e,id)));
    }
    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || owner() || (reviewer() && resource.data.status == 'pending');
      allow list: if owner() || (reviewer() && resource.data.status == 'pending');
      // O perfil inicial só pode ser pending/user. O proprietário é criado pelo procedimento IAM local.
      allow create: if signedIn() && request.auth.uid == uid && uid != '7TitBObtb8a0W8GisSstSM1RHiX2'
        && validUser(request.resource.data,uid) && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user' && request.resource.data.status == 'pending'
        && request.resource.data.version == 1 && request.resource.data.lastEventId == '' && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid != uid && uid != '7TitBObtb8a0W8GisSstSM1RHiX2'
        && validUser(request.resource.data,uid) && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.version == resource.data.version + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status','permissions','version','updatedAt','lastEventId','blockedFrom'])
        && validEvent(getAfter(/databases/$(database)/documents/auditEvents/$(request.resource.data.lastEventId)).data,request.resource.data.lastEventId);
      allow delete: if false;
    }
    match /auditEvents/{id} {
      allow read: if owner();
      allow create: if validEvent(request.resource.data,id);
      allow update, delete: if false;
    }
    match /cacheKeys/{uid} {
      allow get: if active() && request.auth.uid == uid;
      allow create: if active() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['key']) && request.resource.data.key is string && request.resource.data.key.matches('^[a-f0-9]{64}$');
      allow update, delete, list: if false;
    }
    match /admins/{uid} { allow read, write: if false; }
    match /settings/library {
      allow get: if active();
      allow list, create, delete: if false;
      allow update: if owner() && request.resource.data.keys().hasOnly(['publicRead','version','updatedAt','lastEventId'])
        && request.resource.data.keys().hasAll(['publicRead','version','updatedAt','lastEventId'])
        && request.resource.data.publicRead is bool && request.resource.data.updatedAt == request.time
        && request.resource.data.version == resource.data.version + 1
        && validEvent(getAfter(/databases/$(database)/documents/auditEvents/$(request.resource.data.lastEventId)).data,request.resource.data.lastEventId);
    }
    function optionalNumber(value, max) { return value == null || (value is int && value >= 1 && value <= max); }
    function validDuration(g) {
      return (!('minDurationMinutes' in g) && !('maxDurationMinutes' in g))
        || (('minDurationMinutes' in g) && ('maxDurationMinutes' in g)
          && optionalNumber(g.minDurationMinutes,1440) && optionalNumber(g.maxDurationMinutes,1440)
          && ((g.minDurationMinutes == null && g.maxDurationMinutes == null && g.durationMinutes == null)
            || (g.minDurationMinutes != null && g.maxDurationMinutes != null && g.minDurationMinutes <= g.maxDurationMinutes
              && ((g.minDurationMinutes == g.maxDurationMinutes && g.durationMinutes == g.minDurationMinutes)
                || (g.minDurationMinutes != g.maxDurationMinutes && g.durationMinutes == null)))));
    }
    function validDocument(d, id, key) {
      let m=d.manual;
      let previous = previousDocuments();
      let legacy = resource != null && ((key == 'main' && m == resource.data.manual) || (key in previous && m == previous[key].manual));
      return key.matches('^(main|[a-f0-9-]{36})$') && d.keys().hasOnly(['id','name','documentType','language','edition','manual'])
        && d.id == key && d.name is string && d.name.size() > 0 && d.name.size() <= 160
        && d.documentType in ['principal','complemento','referencia','solo','faq','errata','expansao']
        && d.language is string && d.language.size() <= 20 && d.edition is string && d.edition.size() <= 100
        && (legacy || (m.path == 'games/' + id + '/documents/' + key + '.pdf'
          && m.type == 'application/pdf' && m.name is string && m.name.size() <= 255
          && m.size is int && m.size > 0 && m.size <= 52428800 && m.pages is int && m.pages > 0
          && m.sha256.matches('^[a-f0-9]{64}$') && m.storage == 'drive' && m.driveFileId.matches('^[A-Za-z0-9_-]{6,200}$')));
    }
    function docAt(g,id,keys,n) { return keys.size() <= n || validDocument(g.documents[keys[n]],id,keys[n]); }
    function previousDocuments() { return resource != null && ('documents' in resource.data) ? resource.data.documents : {}; }
    function validDocuments(g,id) {
      let old = previousDocuments();
      let changed = ('documents' in g) ? g.documents.diff(old).addedKeys().union(g.documents.diff(old).changedKeys()) : [].toSet();
      return !('documents' in g) ? old.size() == 0 : (g.documents is map && g.documents.size() > 0 && g.documents.size() <= 12
        && g.primaryDocumentId in g.documents && g.manual == g.documents[g.primaryDocumentId].manual
        && (g.documents.diff(old).removedKeys().size() == 0 || owner())
        && g.documentChanges is list && g.documentChanges.size() <= 2 && changed.hasOnly(g.documentChanges)
        && (changed.size() == 0 || (docAt(g,id,g.documentChanges,0) && docAt(g,id,g.documentChanges,1))));
    }
    function validGame(id) {
      let g = request.resource.data;
      return g.keys().hasOnly(['id','title','description','minPlayers','maxPlayers','durationMinutes','minDurationMinutes','maxDurationMinutes','tags','language','manual','cover','sources','bgg','createdAt','updatedAt','createdBy','schemaVersion','isPublic','deleting','deleteRequestedBy','recommendedAge','gameType','mechanics','edition','documents','primaryDocumentId','documentChanges'])
        && g.keys().hasAll(['id','title','description','minPlayers','maxPlayers','durationMinutes','tags','language','manual','cover','sources','createdAt','updatedAt','createdBy','schemaVersion','isPublic','deleting'])
        && g.id == id && g.schemaVersion == 1 && g.isPublic is bool && g.deleting is bool
        && g.title is string && g.title.size() > 0 && g.title.size() <= 160
        && g.description is string && g.description.size() <= 2000
        && optionalNumber(g.minPlayers,100) && optionalNumber(g.maxPlayers,100)
        && ((g.minPlayers == null && g.maxPlayers == null) || (g.minPlayers != null && g.maxPlayers != null && g.minPlayers <= g.maxPlayers))
        && optionalNumber(g.durationMinutes,1440)
        && validDuration(g)
        && g.tags is list && g.tags.size() <= 8 && g.language is string && g.language.size() <= 20
        && (!('recommendedAge' in g) || optionalNumber(g.recommendedAge,100))
        && (!('gameType' in g) || (g.gameType is string && g.gameType.size() <= 80))
        && (!('edition' in g) || (g.edition is string && g.edition.size() <= 100))
        && (!('mechanics' in g) || (g.mechanics is list && g.mechanics.size() <= 8))
        && g.manual is map && (g.manual.path == 'games/' + id + '/manual.pdf' || (('primaryDocumentId' in g) && g.manual.path == 'games/' + id + '/documents/' + g.primaryDocumentId + '.pdf'))
        && validDocuments(g,id)
        && g.manual.name is string && g.manual.name.size() <= 255
        && g.manual.type == 'application/pdf' && g.manual.size is int && g.manual.size > 0 && (g.manual.size <= 52428800 || (resource != null && (g.manual == resource.data.manual || (('primaryDocumentId' in g) && g.primaryDocumentId in previousDocuments() && g.manual == previousDocuments()[g.primaryDocumentId].manual))))
        && g.manual.pages is int && g.manual.pages >= 1
        && g.manual.sha256 is string && g.manual.sha256.matches('^[a-f0-9]{64}$')
        && g.manual.storage == 'drive' && g.manual.driveFileId is string && g.manual.driveFileId.matches('^[A-Za-z0-9_-]{6,200}$')
        && g.cover is map && g.sources is map && g.createdAt is timestamp && g.updatedAt == request.time && g.createdBy is string;
    }
    function documentUpdate(id) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['documents','primaryDocumentId','documentChanges','manual','language','updatedAt'])
        && request.resource.data.updatedAt == request.time && validDocuments(request.resource.data,id)
        && request.resource.data.language == request.resource.data.documents[request.resource.data.primaryDocumentId].language;
    }
    match /games/{id} {
      allow read: if active() && (admin() || ((!('deleting' in resource.data) || resource.data.deleting == false) && (publicLibrary() || resource.data.isPublic == true)));
      allow create: if allowed('addGames') && validGame(id) && request.resource.data.deleting == false && !('deleteRequestedBy' in request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if (allowed('editGames') || owner()) && (documentUpdate(id) || validGame(id)) && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
        && ((allowed('editGames') && (!('deleting' in resource.data) || resource.data.deleting == false)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleting','deleteRequestedBy']))
        || (owner() && request.resource.data.deleting == true && request.resource.data.deleteRequestedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting','deleteRequestedBy','updatedAt'])));
      allow delete: if owner();
    }
    function guideGame(id) { return get(/databases/$(database)/documents/games/$(id)).data; }
    function canReadGuide(id) {
      let g = guideGame(id);
      return active() && (admin() || (g.deleting == false && (publicLibrary() || g.isPublic == true)));
    }
    function canEditGuide(id) { return allowed('editGames') && guideGame(id).deleting == false; }
    function validGuide(g, id) {
      return g.keys().hasOnly(['gameId','schemaVersion','revision','content','sourceHash','assets','indexFileId','reviewed','updatedAt','updatedBy','lastEventId','draftRevision'])
        && g.keys().hasAll(['gameId','schemaVersion','revision','content','sourceHash','assets','indexFileId','reviewed','updatedAt','updatedBy'])
        && g.gameId == id && g.schemaVersion == 1 && g.revision is int && g.revision >= 1
        && g.content is string && g.content.size() <= 350000
        && g.sourceHash is string && g.sourceHash.matches('^[a-f0-9]{64}$')
        && g.assets is map && g.assets.size() <= 100 && g.indexFileId is string && g.indexFileId.size() <= 200
        && g.reviewed is bool && g.updatedAt == request.time && g.updatedBy == request.auth.uid;
    }
    function validGuideEvent(e, eventId) {
      let after = getAfter(/databases/$(database)/documents/gameGuides/$(e.targetId)).data;
      return canEditGuide(e.targetId) && e.action == 'publishGuide' && after.lastEventId == eventId
        && after.revision == e.version && e.after == {'revision':after.revision}
        && e.before == {'revision':after.revision - 1};
    }
    match /guideDrafts/{id} {
      allow get: if allowed('editGames');
      allow list: if false;
      allow create: if canEditGuide(id) && validGuide(request.resource.data,id) && request.resource.data.revision == 1;
      allow update: if canEditGuide(id) && validGuide(request.resource.data,id) && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner();
    }
    function publishGuide(id) {
      let g = request.resource.data;
      let draft = getAfter(/databases/$(database)/documents/guideDrafts/$(id)).data;
      return canEditGuide(id) && validGuide(g,id) && g.reviewed == true && draft.reviewed == true
        && g.content == draft.content && g.sourceHash == draft.sourceHash && g.sourceHash == guideGame(id).manual.sha256
        && g.draftRevision == draft.revision && g.indexFileId == draft.indexFileId
        && g.assets.keys().hasOnly(draft.assets.keys())
        && validEvent(getAfter(/databases/$(database)/documents/auditEvents/$(g.lastEventId)).data,g.lastEventId);
    }
    match /gameGuides/{id} {
      allow get: if canReadGuide(id);
      allow list: if false;
      allow create: if publishGuide(id) && request.resource.data.revision == 1;
      allow update: if publishGuide(id) && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner();
    }
    function documentHash(game,id) { return ('documents' in game) ? game.documents[id].manual.sha256 : (id == 'main' ? game.manual.sha256 : ''); }
    match /games/{id}/indexes/{documentId} {
      allow read: if canReadGuide(id);
      allow create, update: if (canEditGuide(id) || (allowed('addGames') && guideGame(id).createdBy == request.auth.uid && guideGame(id).deleting == false))
        && request.resource.data.keys().hasOnly(['documentId','sourceHash','fileId','state','readablePages','translatedPages','revision','updatedAt','updatedBy'])
        && request.resource.data.documentId == documentId && request.resource.data.sourceHash == documentHash(guideGame(id),documentId)
        && request.resource.data.fileId.matches('^[A-Za-z0-9_-]{6,200}$')
        && (!('readablePages' in request.resource.data) || (request.resource.data.readablePages is int && request.resource.data.readablePages >= 0 && request.resource.data.readablePages <= 20000))
        && (!('translatedPages' in request.resource.data) || (request.resource.data.translatedPages is int && request.resource.data.translatedPages >= 0 && request.resource.data.translatedPages <= 20000))
        && request.resource.data.state in ['ready','partial','attention'] && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1);
      allow delete: if owner();
    }
    match /documentDeletion/{id} {
      allow get, delete: if owner();
      allow create, update: if owner() && guideGame(id).deleting == true && request.resource.data.keys().hasOnly(['done']) && request.resource.data.done is int && request.resource.data.done >= 0 && request.resource.data.done <= 12;
    }
    match /games/{id}/removals/{documentId} {
      allow get, list, delete: if owner();
      allow create: if owner() && documentId.matches('^(main|[a-f0-9-]{36})$')
        && request.resource.data.keys().hasOnly(['gameId','documentId','document','indexFileId','indexSourceHash','removedBy'])
        && request.resource.data.gameId == id && request.resource.data.documentId == documentId
        && request.resource.data.removedBy == request.auth.uid
        && request.resource.data.document == get(/databases/$(database)/documents/games/$(id)).data.documents[documentId]
        && !(documentId in getAfter(/databases/$(database)/documents/games/$(id)).data.documents)
        && (exists(/databases/$(database)/documents/games/$(id)/indexes/$(documentId))
          ? (request.resource.data.indexFileId == get(/databases/$(database)/documents/games/$(id)/indexes/$(documentId)).data.fileId
            && request.resource.data.indexSourceHash == get(/databases/$(database)/documents/games/$(id)/indexes/$(documentId)).data.sourceHash)
          : (request.resource.data.indexFileId == '' && request.resource.data.indexSourceHash == ''));
      allow update: if false;
    }
    match /guideDeletion/{id} {
      allow get, delete: if owner();
      allow create, update: if owner() && guideGame(id).deleting == true
        && request.resource.data.keys().hasOnly(['remaining','preserved'])
        && request.resource.data.remaining is list && request.resource.data.remaining.size() <= 200
        && request.resource.data.preserved is bool;
      allow list: if false;
    }
    // Pesquisa não publicada: somente editores ativos; projeção confirmada segue no jogo.
    function researchEditor() { return allowed('editGames') || allowed('addGames'); }
    function researchGame(id) { return get(/databases/$(database)/documents/games/$(id)).data; }
    function validResearch(id) {
      let r = request.resource.data;
      return r.keys().hasOnly(['gameId','schemaVersion','aliases','content','fetchedAt','revision','updatedAt','updatedBy'])
        && r.keys().hasAll(['gameId','schemaVersion','aliases','content','fetchedAt','revision','updatedAt','updatedBy'])
        && r.gameId == id && r.schemaVersion == 1 && r.aliases is list && r.aliases.size() <= 32
        && r.content is string && r.content.size() <= 120000 && r.fetchedAt is int && r.fetchedAt > 0
        && r.revision is int && r.updatedBy == request.auth.uid && r.updatedAt == request.time
        && exists(/databases/$(database)/documents/games/$(id)) && researchGame(id).deleting == false
        && (allowed('editGames') || (allowed('addGames') && researchGame(id).createdBy == request.auth.uid));
    }
    match /gameResearch/{id} {
      allow read: if researchEditor();
      allow create: if researchEditor() && validResearch(id) && request.resource.data.revision == 1;
      allow update: if researchEditor() && validResearch(id) && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
