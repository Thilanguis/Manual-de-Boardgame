{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acervo-drive-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "manual-de-boardgame",
