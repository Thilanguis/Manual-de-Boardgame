{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.eol": "\n",
  "files.encoding": "utf8",
  "prettier.requireConfig": true,
  "files.exclude": {
    "public": true,
    "node_modules": true,
    ".test-tools": true,
    ".secrets": true,
    ".build": true,
    "test-output": true,
    "worker/node_modules": true,
    "worker/.wrangler": true,
    "worker/.build": true,
    "tests/runtime/node_modules": true
  },
  "search.exclude": {
    "vendor": true,
    "public": true,
    "node_modules": true,
    ".test-tools": true,
    ".secrets": true,
    ".build": true,
    "test-output": true,
    "worker/.wrangler": true,
    "worker/.build": true
  },
  "liveServer.settings.ignoreFiles": ["**"]
}
